{
  "openapi": "3.1.0",
  "info": {"title": "BIST Chart Visual Fetcher", "version": "7.4.0"},
  "servers": [{"url": "https://bist-chart-gpt-action.onrender.com"}],
  "paths": {
    "/health": {"get": {"operationId": "health", "summary": "Health check", "responses": {"200": {"description": "OK"}}}},
    "/debug/range-target": {"get": {"operationId": "debugRangeTarget", "summary": "Compute target session range", "parameters": [{"name":"target_date","in":"query","schema":{"type":"string"}}], "responses": {"200":{"description":"OK"}}}},
    "/prepare-chart": {"get": {"operationId": "prepareChart", "summary": "Prepare BIST chart visual", "parameters": [
      {"name":"symbol","in":"query","required":true,"schema":{"type":"string"}},
      {"name":"interval","in":"query","schema":{"type":"string","default":"5m"}},
      {"name":"target_date","in":"query","schema":{"type":"string"}},
      {"name":"view","in":"query","schema":{"type":"string","default":"session"}}
    ], "responses": {"200":{"description":"OK"}}}},
    "/capture-chart": {"get": {"operationId": "captureChart", "summary": "Capture prepared chart", "parameters": [{"name":"session_id","in":"query","required":true,"schema":{"type":"string"}}], "responses": {"200":{"description":"OK"}}}},
    "/chart-agent": {"get": {"operationId": "chartAgent", "summary": "Prepare and capture chart in one call", "parameters": [
      {"name":"symbol","in":"query","required":true,"schema":{"type":"string"}},
      {"name":"interval","in":"query","schema":{"type":"string","default":"5m"}},
      {"name":"target_date","in":"query","schema":{"type":"string"}},
      {"name":"view","in":"query","schema":{"type":"string","default":"session"}}
    ], "responses": {"200":{"description":"OK"}}}}
  }
}
