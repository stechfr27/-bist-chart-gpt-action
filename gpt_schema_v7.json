{
  "openapi": "3.1.0",
  "info": {
    "title": "BIST Grafik Görseli Getir API",
    "description": "BIST hisse grafiğini TradingView üzerinde hazırlayan ve sadece görsel/screenshot URL döndüren Custom GPT Action API. Analiz yapmaz.",
    "version": "7.2.0"
  },
  "servers": [
    {
      "url": "https://bist-chart-gpt-action.onrender.com",
      "description": "Render servis URL'si"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Servis durumunu kontrol et",
        "responses": {
          "200": {
            "description": "Servis aktif"
          }
        }
      }
    },
    "/debug/range-target": {
      "get": {
        "operationId": "debugRangeTarget",
        "summary": "Browser açmadan hedef BIST seans saatini hesapla",
        "parameters": [
          {
            "name": "target_date",
            "in": "query",
            "required": false,
            "description": "YYYY-MM-DD tarihli grafik için hedef tarih",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hedef saat hesaplandı"
          }
        }
      }
    },
    "/prepare-chart": {
      "get": {
        "operationId": "prepareChart",
        "summary": "Grafiği TradingView üzerinde hazırla",
        "description": "Grafiği açar, 5dk/tarih/seans aralığı hedefini uygular, son mum üstü hover dener ve capture için session_id döndürür. Analiz yapmaz.",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "description": "BIST sembolü. Örn: THYAO, ASELS",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "description": "Mum aralığı. Varsayılan 5m.",
            "schema": {
              "type": "string",
              "default": "5m"
            }
          },
          {
            "name": "target_date",
            "in": "query",
            "required": false,
            "description": "YYYY-MM-DD tarihli grafik için; boşsa güncel gün.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "current"
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Grafik hazırlandı veya hangi aşamada takıldığı döndü"
          }
        }
      }
    },
    "/capture-chart": {
      "get": {
        "operationId": "captureChart",
        "summary": "Hazırlanmış grafiğin screenshot'ını al",
        "description": "prepareChart sonucundaki session_id ile ekrandaki hazır grafiği çeker ve screenshot_url döndürür. Analiz yapmaz.",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "close_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "include_base64",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Screenshot alındı veya hata aşaması döndü"
          }
        }
      }
    },
    "/chart-agent": {
      "get": {
        "operationId": "chartAgent",
        "summary": "Tek çağrıda hazırla ve çek",
        "description": "Tek çağrıda hazırla ve çek dener. Ama Custom GPT için önerilen ana akış prepareChart → captureChart şeklindedir. Sadece görsel döndürür, analiz yapmaz.",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5m"
            }
          },
          {
            "name": "target_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "current"
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hazırla ve çek sonucu"
          }
        }
      }
    }
  }
}