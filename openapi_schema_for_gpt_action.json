{
  "openapi": "3.1.0",
  "info": {
    "title": "BIST Chart GPT Action API v3.5 Session Full-Day",
    "version": "3.5.0"
  },
  "servers": [
    {
      "url": "https://bist-chart-gpt-action.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/warmup": {
      "get": {
        "operationId": "warmup",
        "responses": {
          "200": {
            "description": "Browser warmup"
          }
        }
      }
    },
    "/chart": {
      "get": {
        "operationId": "getBistChart",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "BIST symbol, e.g. THYAO, ASELS"
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5m",
              "enum": [
                "1m",
                "3m",
                "5m",
                "10m",
                "15m",
                "30m",
                "1h",
                "1d"
              ]
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "current",
              "enum": [
                "current",
                "safe_current",
                "balanced",
                "fast"
              ]
            },
            "description": "current for latest full-day visual, safe_current for more patient current capture, balanced for dated/range requests."
          },
          {
            "name": "range_hint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5d"
            }
          },
          {
            "name": "target_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD. For a dated request, use mode=balanced&view=session. TradingView date navigation is best-effort; OHLC layer is used for date verification."
          },
          {
            "name": "include_base64",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "auto_clear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "session",
              "enum": [
                "session",
                "full_day",
                "day",
                "auto"
              ]
            },
            "description": "session/full_day/day fits the latest BIST session open-to-close from open to close on the screenshot. auto uses older behavior."
          }
        ],
        "responses": {
          "200": {
            "description": "Strict TradingView session/full-day chart response"
          }
        }
      }
    }
  }
}