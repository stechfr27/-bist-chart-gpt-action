{
  "openapi": "3.1.0",
  "info": {
    "title": "BIST Chart GPT Action",
    "version": "1.0.0",
    "description": "BIST hisseleri için TradingView mum grafik ekran görüntüsü ve doğrulama amaçlı OHLC verisi döndürür."
  },
  "servers": [
    {
      "url": "https://YOUR-DEPLOYED-URL.onrender.com"
    }
  ],
  "paths": {
    "/chart": {
      "get": {
        "operationId": "getBistChart",
        "summary": "BIST hisse mum grafiği ekran görüntüsü ve OHLC verisi al",
        "parameters": [
          {"name":"symbol","in":"query","required":true,"schema":{"type":"string"},"description":"BIST sembolü: THYAO, ASELS, TUPRS gibi"},
          {"name":"interval","in":"query","required":false,"schema":{"type":"string","enum":["1m","3m","5m","10m","15m","30m","1h","1d"],"default":"5m"}},
          {"name":"range_hint","in":"query","required":false,"schema":{"type":"string","default":"5d"},"description":"1d, 5d, 1mo, 3mo, 6mo, 1y gibi"},
          {"name":"target_date","in":"query","required":false,"schema":{"type":"string"},"description":"YYYY-MM-DD formatında tarih"}
        ],
        "responses": {
          "200": {
            "description": "Grafik ekran görüntüsü ve OHLC verisi",
            "content": {"application/json": {"schema": {"type": "object"}}}
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Servis sağlık kontrolü",
        "responses": {"200": {"description":"OK"}}
      }
    }
  }
}
