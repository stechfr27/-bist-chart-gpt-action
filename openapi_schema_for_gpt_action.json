{
  "openapi": "3.1.0",
  "info": {
    "title": "BIST Chart GPT Action API",
    "version": "2.5.0",
    "description": "BIST chart screenshot API. current=45s safe-fast; safe_current=60s; balanced=historical/OHLC."
  },
  "servers": [
    {
      "url": "https://YOUR-RENDER-URL.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Check service health",
        "responses": {
          "200": {
            "description": "Service health"
          }
        }
      }
    },
    "/warmup": {
      "get": {
        "operationId": "warmupBrowser",
        "summary": "Warm up browser for faster chart screenshots",
        "responses": {
          "200": {
            "description": "Warmup result"
          }
        }
      }
    },
    "/chart": {
      "get": {
        "operationId": "getBistChartSnapshot",
        "summary": "Get BIST chart screenshot and verification data",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "BIST symbol, e.g. THYAO, ASELS, TUPRS"
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5m",
              "enum": [
                "1m",
                "3m",
                "5m",
                "10m",
                "15m",
                "30m",
                "1h",
                "1d"
              ]
            },
            "description": "Chart interval"
          },
          {
            "name": "range_hint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5d"
            },
            "description": "Yahoo period hint for balanced mode"
          },
          {
            "name": "target_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD for dated analysis"
          },
          {
            "name": "include_base64",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Return screenshot base64. Usually false."
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "current",
              "enum": [
                "current",
                "safe_current",
                "balanced",
                "fast"
              ]
            },
            "description": "current (default, 45s safe-fast), safe_current (60s safer), balanced (historical/OHLC), fast (legacy)"
          }
        ],
        "responses": {
          "200": {
            "description": "Chart screenshot and verification data"
          }
        }
      }
    }
  }
}