{
  "openapi": "3.1.0",
  "info": {
    "title": "BIST Chart GPT Action API v3.2 Browserless",
    "version": "3.2.0"
  },
  "servers": [
    {
      "url": "https://bist-chart-gpt-action.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/warmup": {
      "get": {
        "operationId": "warmup",
        "responses": {
          "200": {
            "description": "Browser warmup"
          }
        }
      }
    },
    "/chart": {
      "get": {
        "operationId": "getBistChart",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "BIST symbol, e.g. THYAO, ASELS"
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5m",
              "enum": [
                "1m",
                "3m",
                "5m",
                "10m",
                "15m",
                "30m",
                "1h",
                "1d"
              ]
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "current",
              "enum": [
                "current",
                "safe_current",
                "balanced",
                "fast"
              ]
            }
          },
          {
            "name": "range_hint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5d"
            }
          },
          {
            "name": "target_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_base64",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "auto_clear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Strict TradingView chart response"
          }
        }
      }
    }
  }
}