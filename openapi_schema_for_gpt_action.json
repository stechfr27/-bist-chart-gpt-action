{
  "openapi": "3.1.0",
  "info": {
    "title": "BIST Chart GPT Action API",
    "description": "BIST hisseleri için hızlı güncel TradingView screenshot, public quote doğrulama ve gerektiğinde Yahoo/Stooq OHLC sağlar.",
    "version": "1.9.0"
  },
  "servers": [
    {
      "url": "https://bist-chart-gpt-action.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "checkBistChartApiHealth",
        "summary": "API sağlık ve sürüm kontrolü",
        "responses": {
          "200": {
            "description": "Servis durumu"
          }
        }
      }
    },
    "/warmup": {
      "get": {
        "operationId": "warmupBistChartBrowser",
        "summary": "TradingView browser warmup yapar",
        "responses": {
          "200": {
            "description": "Browser hazır"
          }
        }
      }
    },
    "/chart": {
      "get": {
        "operationId": "getBistChartSnapshot",
        "summary": "BIST hissesi için grafik screenshot ve doğrulama verisi al",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "BIST sembolü. Örn: THYAO, ASELS, TUPRS"
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "3m",
                "5m",
                "10m",
                "15m",
                "30m",
                "1h",
                "1d"
              ],
              "default": "5m"
            }
          },
          {
            "name": "range_hint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1d"
            },
            "description": "Yahoo period ipucu. Güncel analizde önemli değildir; balanced/tarihli analizde kullanılır."
          },
          {
            "name": "target_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD formatında tarihli analiz isteği."
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "current",
                "fast",
                "balanced"
              ],
              "default": "current"
            },
            "description": "current: güncel grafik için en hızlı güvenli mod; TradingView screenshot + Midas/Bloomberg hızlı teyit. balanced: OHLC/Yahoo/Stooq daha detaylı."
          },
          {
            "name": "include_base64",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "true ise screenshot base64 döner; normalde false kalmalı."
          }
        ],
        "responses": {
          "200": {
            "description": "Grafik screenshot URL'i ve doğrulama verileri"
          }
        }
      }
    }
  }
}